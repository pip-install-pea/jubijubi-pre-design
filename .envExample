# DATABASE CONNECTION
# PostgreSQL connection string (e.g. postgresql://username:password@hostname:port/dbname?sslmode=require)
DATABASE_URL=postgresql://username:password@hostname:port/dbname?sslmode=require

# SECRET KEYS FOR JWT/COOKIES
# Secret keys used for signing sessions and cryptographic utilities
SECRET_KEY=your_fallback_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# DATA SYNC CONFIG
# Configuration parameters for backend data synchronization engines
SYNC_INTERVAL_HOURS=6
SYNC_INTERVAL_MS=1800000
API_TIMEOUT=30
API_RETRY_COUNT=2

# Health incremental sync starts here (not 2026-05-01). Lookup tables still send from_date/to_date.
HEALTH_SYNC_START=2025-01-01
HEALTH_SUMMARY_YEARS=2024,2025,2026

# Optional mixprogram.php payloads
EDU_PROGRAM_ID=5
EDU_MIX_YEARS=2024-25,2025-26
