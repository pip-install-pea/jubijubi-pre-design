# DATABASE CONNECTION
# Local Postgres (no SSL):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jubilant?sslmode=disable
# Neon / cloud (SSL required):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/jubilant?sslmode=disable

# Optional override: true | false. If unset, sslmode in DATABASE_URL wins.
# DATABASE_SSL=false

# SECRET KEYS FOR JWT/COOKIES
SECRET_KEY=your_fallback_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# DATA SYNC CONFIG
SYNC_INTERVAL_HOURS=6
SYNC_INTERVAL_MS=1800000
API_TIMEOUT=30
API_RETRY_COUNT=2

# Health incremental sync starts here (not 2026-05-01). Lookup tables still send from_date/to_date.
HEALTH_SYNC_START=2025-01-01
HEALTH_SUMMARY_YEARS=2024,2025,2026

# Optional mixprogram.php payloads
EDU_PROGRAM_ID=5
EDU_MIX_YEARS=2024-25,2025-26

# Bounded disease-patient pull during sync (PHP 500s on huge windows)
DISEASE_PATIENT_LIMIT=50
DISEASE_PATIENT_MAX_IDS=12
